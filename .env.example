# OpenAI-compatible chat endpoint. These defaults target a local Ollama server.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=gemma3:4b
LLM_TIMEOUT_S=600
MAX_STEPS=6

# Embeddings used to index and retrieve runbooks.
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_API_KEY=
EMBEDDING_MODEL=all-minilm

# Optional override used by app/eval/run_eval.py.
EVAL_API_URL=http://127.0.0.1:8000/run
